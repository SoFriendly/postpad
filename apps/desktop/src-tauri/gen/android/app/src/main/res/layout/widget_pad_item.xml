<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/item"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp"
    android:paddingTop="10dp" android:paddingBottom="10dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textColor="@color/pp_ink" android:textSize="15sp" android:textStyle="bold" android:fontFamily="serif"
            android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/age" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:paddingStart="8dp" android:textColor="@color/pp_muted" android:textSize="12sp" android:fontFamily="monospace" />
    </LinearLayout>
    <TextView android:id="@+id/summary" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingTop="2dp" android:textColor="@color/pp_muted" android:textSize="13sp"
        android:maxLines="2" android:ellipsize="end" />
</LinearLayout>
